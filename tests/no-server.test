package require tcltest 2
namespace import ::tcltest::*

test captcha-no-server {challenge generation works when twebserver is unavailable} -setup {
    set child [interp create]
    interp eval $child [list set auto_path $::auto_path]
} -body {
    interp eval $child {
        rename package original_package
        proc package {command args} {
            if {$command eq "require" && "twebserver" in $args} {
                error "twebserver is unavailable"
            }
            tailcall original_package $command {*}$args
        }
        package require tcaptcha 1.0.0
        set mac [::tink::register_keyset [::tink::mac::create_keyset HMAC_SHA256]]
        try {
            set challenge [::tcaptcha::create -mac $mac -context standalone]
            list [binary encode hex [string range [dict get $challenge png] 0 7]] \
                [string length [dict get $challenge state id]] [package provide twebserver]
        } finally {::tink::unregister_keyset $mac}
    }
} -cleanup {
    interp delete $child
} -result {89504e470d0a1a0a 32 {}}

cleanupTests
